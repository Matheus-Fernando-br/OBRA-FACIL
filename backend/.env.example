# Copie para .env (que NÃO vai para o Git) e preencha para rodar localmente.
# Em produção, configure estas variáveis no painel do Render.

NODE_ENV=development
PORT=8000

# MongoDB (Atlas ou local). Ex.: mongodb+srv://usuario:senha@cluster/obrafacil
MONGO_URI=

# Segredos com 32+ caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=

# Duração das sessões (segundos)
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Painel administrativo (/admin). A senha inicial só é usada para criar o
# administrador na primeira inicialização; troque-a no primeiro acesso e
# remova a variável depois.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# ADMIN_FORCE_RESET=true   # só para recuperar o acesso (ver README)

# Endereço público da API (usado nos links do Mercado Pago)
PUBLIC_BASE_URL=http://localhost:8000
# Origens web permitidas (separadas por vírgula). O app nativo não precisa.
CORS_ORIGINS=http://localhost:8081

# E-mail (Brevo). Sem chave em desenvolvimento, o código aparece no terminal.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Obra Fácil
SUPPORT_EMAIL=r2m.tec.adm@gmail.com

# Mercado Pago (use credenciais de TESTE em desenvolvimento)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Chave pública do mesmo par de credenciais (formulário de cartão/Pix na página /assinar)
MP_PUBLIC_KEY=

LOG_LEVEL=info
